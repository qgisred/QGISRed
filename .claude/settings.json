{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 .claude/hooks/check_python_edit.py",
            "shell": "bash",
            "timeout": 60,
            "statusMessage": "Running flake8 + pytest..."
          }
        ]
      }
    ]
  }
}
